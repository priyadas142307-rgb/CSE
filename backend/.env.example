# Django Backend Environment Configuration

# Security: Set a secure, unique key in production
SECRET_KEY=change-to-a-very-long-random-secret-key-in-production

# Debug mode: Set to False for production
DEBUG=False

# Allowed hosts: comma-separated list of domains/IPs
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database URL (dj-database-url format)
# SQLite default: sqlite:///db.sqlite3
# PostgreSQL example: postgres://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Cross-Origin Resource Sharing (CORS) - frontend domains
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-frontend.vercel.app

# CSRF trusted origins - frontend domains
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-frontend.vercel.app

# Cookie security (set to True when using HTTPS in production)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
